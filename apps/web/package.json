{
  "name": "@human-atlas/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run wasm:build --prefix ../..",
    "dev": "vite --host localhost",
    "prebuild": "npm run wasm:build --prefix ../..",
    "build": "tsc --noEmit && vite build",
    "serve": "node scripts/serve.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "pretest:browser": "npm run wasm:build --prefix ../..",
    "test:browser": "node scripts/test-browser.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@tauri-apps/api": ">=2 <3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": ">=2 <3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "gltf-validator": "^2.0.0-dev.3.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
