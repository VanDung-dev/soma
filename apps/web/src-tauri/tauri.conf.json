{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soma",
  "version": "0.1.0",
  "identifier": "io.github.vandung-dev.soma",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build -- --mode desktop",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [{
      "label": "main",
      "url": "home",
      "title": "Soma — Tự học giải phẫu",
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "trafficLightPosition": { "x": 16, "y": 26 },
      "width": 1280,
      "height": 800,
      "minWidth": 800,
      "minHeight": 520,
      "preventOverflow": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' data:; frame-src 'self' https:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/models/**/*"]
      },
      "devCsp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173; img-src 'self' data:; frame-src 'self' https:"
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "../public/models/": "models/",
      "../public/home/ATTRIBUTION.md": "home/ATTRIBUTION.md"
    },
    "publisher": "Nguyễn Lê Văn Dũng",
    "copyright": "© 2026 Nguyễn Lê Văn Dũng",
    "license": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
