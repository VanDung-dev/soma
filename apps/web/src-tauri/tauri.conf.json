{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soma",
  "version": "0.1.0-dev1",
  "identifier": "io.github.vandung-dev.soma",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build -- --mode desktop",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [{
      "label": "main",
      "dragDropEnabled": false,
      "url": "home",
      "title": "Soma — Tự học giải phẫu",
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "trafficLightPosition": { "x": 12, "y": 22 },
      "width": 1280,
      "height": 800,
      "minWidth": 800,
      "minHeight": 500,
      "preventOverflow": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; connect-src 'self' blob: ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' data: blob:; frame-src 'self' https: http://127.0.0.1:*",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/models/**/*"]
      },
      "devCsp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; connect-src 'self' blob: ipc: http://ipc.localhost ws://localhost:5173; img-src 'self' data: blob:; frame-src 'self' https:"
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "../public/models/": "models/",
      "../public/home/ATTRIBUTION.md": "home/ATTRIBUTION.md",
      "../public/icons/ATTRIBUTION.md": "icons/ATTRIBUTION.md",
      "../public/hand-input/ATTRIBUTION.md": "hand-input/ATTRIBUTION.md",
      "../../../LICENSE": "licenses/LICENSE.txt",
      "../../../NOTICE": "licenses/NOTICE.txt",
      "../../../licenses/brotli.txt": "licenses/brotli.txt",
      "../../../licenses/lesson-content.txt": "licenses/lesson-content.txt",
      "../../../licenses/squoosh.txt": "licenses/squoosh.txt",
      "../../../node_modules/tinymce/license.md": "licenses/tinymce.md",
      "../../../node_modules/dompurify/LICENSE": "licenses/dompurify.txt"
    },
    "publisher": "Nguyễn Lê Văn Dũng",
    "copyright": "© 2026 Nguyễn Lê Văn Dũng",
    "license": "Soma Community and Commercial Use License 1.0",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "15.0"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer-assets/nsis-header.bmp",
        "sidebarImage": "installer-assets/nsis-sidebar.bmp",
        "uninstallerHeaderImage": "installer-assets/nsis-header.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
